{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil dan peran pengguna (admin, guru, atau wali_kelas) SMP Muhammadiyah Al Furqan",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin", "guru", "wali_kelas"]
        },
        "kelasDiampu": {
          "type": "array",
          "description": "Daftar kelas yang diajar oleh guru (misal ['7A', '7B'])"
        },
        "mapelDiampu": {
          "type": "array",
          "description": "Daftar mata pelajaran yang diampu oleh guru"
        },
        "waliKelas": {
          "type": "string",
          "maxLength": 20,
          "description": "Kelas perwalian jika berperan sebagai wali_kelas (misal '7A')"
        },
        "aktif": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "nama", "email", "role", "kelasDiampu", "mapelDiampu", "waliKelas", "aktif", "createdAt", "updatedAt"]
    },
    "Siswa": {
      "title": "Siswa",
      "description": "Data pokok siswa per kelas di SMP Muhammadiyah Al Furqan",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9._\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "jenisKelamin": {
          "type": "string",
          "enum": ["L", "P"]
        },
        "aktif": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "nis", "nama", "kelas", "jenisKelamin", "aktif", "createdAt", "updatedAt"]
    },
    "Absensi": {
      "title": "Absensi",
      "description": "Catatan kehadiran harian siswa per tanggal dan kelas",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "siswaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "namaSiswa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "tanggal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["Hadir", "Sakit", "Izin", "Alpa"]
        },
        "keterangan": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "siswaId", "namaSiswa", "kelas", "tanggal", "status", "keterangan", "createdAt", "updatedAt"]
    },
    "Nilai": {
      "title": "Nilai",
      "description": "Nilai siswa per mata pelajaran, kelas, dan jenis penilaian",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "siswaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "namaSiswa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "mapel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "jenis": {
          "type": "string",
          "enum": ["Tugas", "UH", "PTS", "PAS", "Praktik"]
        },
        "judul": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tanggal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "skor": {
          "type": "number"
        },
        "catatan": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "siswaId", "namaSiswa", "kelas", "mapel", "jenis", "judul", "tanggal", "skor", "catatan", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profil dan hak akses pengguna (admin, guru, wali_kelas)"
    },
    "/siswa/{siswaId}": {
      "schema": { "$ref": "#/entities/Siswa" },
      "description": "Daftar data siswa sekolah (dikelola Admin, dibaca Guru/Wali Kelas sesuai kelasnya)"
    },
    "/absensi/{absensiId}": {
      "schema": { "$ref": "#/entities/Absensi" },
      "description": "Rekam absensi harian siswa (diinput Guru kelas yang diajar atau Admin, dibaca Wali Kelas)"
    },
    "/nilai/{nilaiId}": {
      "schema": { "$ref": "#/entities/Nilai" },
      "description": "Rekam nilai siswa (diinput Guru mapel & kelas yang diajar atau Admin, dibaca Wali Kelas)"
    }
  }
}
