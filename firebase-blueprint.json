{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil dan peran pengguna (admin, guru, atau wali_kelas) SMP Muhammadiyah Al Furqan",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin", "guru", "wali_kelas"]
        },
        "kelasDiampu": {
          "type": "array",
          "description": "Daftar kelas yang diajar oleh guru (misal ['7A', '7B'])"
        },
        "mapelDiampu": {
          "type": "array",
          "description": "Daftar mata pelajaran yang diampu oleh guru"
        },
        "waliKelas": {
          "type": "string",
          "maxLength": 20,
          "description": "Kelas perwalian jika berperan sebagai wali_kelas (misal '7A')"
        },
        "aktif": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "nama", "email", "role", "kelasDiampu", "mapelDiampu", "waliKelas", "aktif", "createdAt", "updatedAt"]
    },
    "Siswa": {
      "title": "Siswa",
      "description": "Data pokok siswa dengan ID dokumen berupa NIS: siswa/{nis}",
      "type": "object",
      "properties": {
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "jk": {
          "type": "string",
          "enum": ["L", "P"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["nama", "kelas", "jk", "createdAt", "updatedAt"]
    },
    "Kelas": {
      "title": "Kelas",
      "description": "Master data kelas sekolah: kelas/{id}",
      "type": "object",
      "properties": {
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "waliKelas": {
          "type": "string",
          "maxLength": 100
        },
        "tahunAjaran": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["nama", "waliKelas", "tahunAjaran", "createdAt", "updatedAt"]
    },
    "Mapel": {
      "title": "Mapel",
      "description": "Master data mata pelajaran: mapel/{id}",
      "type": "object",
      "properties": {
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "guruId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["nama", "guruId", "createdAt", "updatedAt"]
    },
    "Absensi": {
      "title": "Absensi",
      "description": "Catatan kehadiran harian per kelas dan tanggal: absensi/{kelasId_tanggal}",
      "type": "object",
      "properties": {
        "tanggal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "records": {
          "type": "object",
          "description": "Peta NIS ke status kehadiran ('H' | 'S' | 'I' | 'A')"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["tanggal", "kelas", "records", "createdAt", "updatedAt"]
    },
    "Nilai": {
      "title": "Nilai",
      "description": "Nilai siswa per mata pelajaran dan semester: nilai/{nis_mapel_semester}",
      "type": "object",
      "properties": {
        "nis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mapel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "semester": {
          "type": "string",
          "enum": ["Ganjil", "Genap"]
        },
        "tugas": {
          "type": "number"
        },
        "uts": {
          "type": "number"
        },
        "uas": {
          "type": "number"
        },
        "akhir": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["nis", "kelas", "mapel", "semester", "akhir", "createdAt", "updatedAt"]
    },
    "RekapAbsen": {
      "title": "RekapAbsen",
      "description": "Ringkasan H/S/I/A bulanan per kelas: rekapAbsen/{kelasId_bulan}",
      "type": "object",
      "properties": {
        "kelas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bulan": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "ringkasan": {
          "type": "object",
          "description": "Ringkasan H/S/I/A per NIS siswa dalam bulan tersebut"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kelas", "bulan", "ringkasan", "updatedAt"]
    },
    "PengaturanBobotNilai": {
      "title": "PengaturanBobotNilai",
      "description": "Pengaturan bobot nilai akhir (Tugas, UTS, UAS) yang diatur Admin",
      "type": "object",
      "properties": {
        "tugas": { "type": "number" },
        "uts": { "type": "number" },
        "uas": { "type": "number" },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["tugas", "uts", "uas", "updatedAt"]
    },
    "PengaturanKkm": {
      "title": "PengaturanKkm",
      "description": "Pengaturan nilai KKM sekolah (0-100) untuk Rekap Nilai",
      "type": "object",
      "properties": {
        "kkm": { "type": "number" },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kkm", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profil dan hak akses pengguna (admin, guru, wali_kelas)"
    },
    "/siswa/{nis}": {
      "schema": { "$ref": "#/entities/Siswa" },
      "description": "Data siswa dengan ID dokumen NIS: nama, kelas, jk"
    },
    "/kelas/{kelasId}": {
      "schema": { "$ref": "#/entities/Kelas" },
      "description": "Daftar kelas: nama, waliKelas, tahunAjaran"
    },
    "/mapel/{mapelId}": {
      "schema": { "$ref": "#/entities/Mapel" },
      "description": "Daftar mata pelajaran: nama, guruId"
    },
    "/absensi/{absensiId}": {
      "schema": { "$ref": "#/entities/Absensi" },
      "description": "Absensi harian kelas ({kelasId_tanggal}): tanggal, kelas, records {nis: H|S|I|A}"
    },
    "/nilai/{nilaiId}": {
      "schema": { "$ref": "#/entities/Nilai" },
      "description": "Nilai siswa ({nis_mapel_semester}): nis, kelas, mapel, semester, tugas, uts, uas, akhir"
    },
    "/rekapAbsen/{rekapId}": {
      "schema": { "$ref": "#/entities/RekapAbsen" },
      "description": "Ringkasan absensi bulanan ({kelasId_bulan}): ringkasan H/S/I/A per siswa"
    },
    "/pengaturan/{pengaturanId}": {
      "schema": { "$ref": "#/entities/PengaturanBobotNilai" },
      "description": "Pengaturan sekolah seperti bobot nilai akhir (bobotNilai) dan KKM (kkm)"
    }
  }
}
