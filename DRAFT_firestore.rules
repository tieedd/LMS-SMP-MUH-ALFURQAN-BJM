rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveProfile() {
      return isVerifiedUser() &&
        exists(userDocPath(request.auth.uid)) &&
        get(userDocPath(request.auth.uid)).data.aktif == true;
    }

    function myProfile() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'darry.hafidh20@admin.sd.belajar.id' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasActiveProfile() && myProfile().role == 'admin')
      );
    }

    function isGuru() {
      return hasActiveProfile() && myProfile().role == 'guru';
    }

    function isWaliKelas() {
      return hasActiveProfile() && myProfile().role == 'wali_kelas';
    }

    function kelasExists(kelasId) {
      return isValidId(kelasId) &&
        exists(/databases/$(database)/documents/kelas/$(kelasId));
    }

    function siswaInKelas(nis, kelas) {
      return isValidId(nis) &&
        exists(/databases/$(database)/documents/siswa/$(nis)) &&
        get(/databases/$(database)/documents/siswa/$(nis)).data.kelas == kelas;
    }

    function isValidStringList(arr, maxItems, maxItemLen) {
      return arr is list &&
        arr.size() <= maxItems &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= maxItemLen));
    }

    function isValidScoreOrNull(val) {
      return val == null || ((val is int || val is float) && val >= 0 && val <= 100);
    }

    // --- Validation Blueprints ---
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'nama', 'email', 'role', 'kelasDiampu', 'mapelDiampu', 'waliKelas', 'aktif', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'nama', 'email', 'role', 'kelasDiampu', 'mapelDiampu', 'waliKelas', 'aktif', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId &&
        data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.role is string && data.role in ['admin', 'guru', 'wali_kelas'] &&
        isValidStringList(data.kelasDiampu, 20, 20) &&
        isValidStringList(data.mapelDiampu, 20, 60) &&
        data.waliKelas is string && data.waliKelas.size() <= 20 &&
        data.aktif is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidKelas(data) {
      return data.keys().hasAll(['nama', 'waliKelas', 'tahunAjaran', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nama', 'waliKelas', 'tahunAjaran', 'createdAt', 'updatedAt']) &&
        isValidId(data.nama) && data.nama.size() <= 20 &&
        data.waliKelas is string && data.waliKelas.size() <= 100 &&
        data.tahunAjaran is string && data.tahunAjaran.size() >= 4 && data.tahunAjaran.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMapel(data) {
      return data.keys().hasAll(['nama', 'guruId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nama', 'guruId', 'createdAt', 'updatedAt']) &&
        data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 60 &&
        data.guruId is string && data.guruId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiswa(data) {
      return data.keys().hasAll(['nama', 'kelas', 'jk', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nama', 'kelas', 'jk', 'createdAt', 'updatedAt']) &&
        data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 100 &&
        isValidId(data.kelas) && data.kelas.size() <= 20 &&
        data.jk is string && data.jk in ['L', 'P'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAbsensi(data) {
      return data.keys().hasAll(['tanggal', 'kelas', 'records', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['tanggal', 'kelas', 'records', 'createdAt', 'updatedAt']) &&
        data.tanggal is string && data.tanggal.size() == 10 && data.tanggal.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        isValidId(data.kelas) && data.kelas.size() <= 20 &&
        data.records is map && data.records.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNilai(data) {
      return data.keys().hasAll(['nis', 'kelas', 'mapel', 'semester', 'tugas', 'uts', 'uas', 'akhir', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nis', 'kelas', 'mapel', 'semester', 'tugas', 'uts', 'uas', 'akhir', 'createdAt', 'updatedAt']) &&
        isValidId(data.nis) && data.nis.size() <= 30 &&
        isValidId(data.kelas) && data.kelas.size() <= 20 &&
        data.mapel is string && data.mapel.size() >= 1 && data.mapel.size() <= 60 &&
        data.semester is string && data.semester in ['Ganjil', 'Genap'] &&
        isValidScoreOrNull(data.tugas) &&
        isValidScoreOrNull(data.uts) &&
        isValidScoreOrNull(data.uas) &&
        (data.akhir is int || data.akhir is float) && data.akhir >= 0 && data.akhir <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRekapAbsen(data) {
      return data.keys().hasAll(['kelas', 'bulan', 'ringkasan', 'updatedAt']) &&
        data.keys().hasOnly(['kelas', 'bulan', 'ringkasan', 'updatedAt']) &&
        isValidId(data.kelas) && data.kelas.size() <= 20 &&
        data.bulan is string && data.bulan.size() == 7 && data.bulan.matches('^\\d{4}-\\d{2}$') &&
        data.ringkasan is map && data.ringkasan.size() <= 100 &&
        data.updatedAt is timestamp;
    }

    function isValidBobotNilai(data) {
      return data.keys().hasAll(['tugas', 'uts', 'uas', 'updatedAt']) &&
        data.keys().hasOnly(['tugas', 'uts', 'uas', 'updatedAt']) &&
        (data.tugas is int || data.tugas is float) && data.tugas >= 0 && data.tugas <= 100 &&
        (data.uts is int || data.uts is float) && data.uts >= 0 && data.uts <= 100 &&
        (data.uas is int || data.uas is float) && data.uas >= 0 && data.uas <= 100 &&
        (data.tugas + data.uts + data.uas) == 100 &&
        data.updatedAt is timestamp;
    }

    function isValidKkm(data) {
      return data.keys().hasAll(['kkm', 'updatedAt']) &&
        data.keys().hasOnly(['kkm', 'updatedAt']) &&
        (data.kkm is int || data.kkm is float) && data.kkm >= 0 && data.kkm <= 100 &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /test/connection {
      allow get: if isSignedIn();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        isAdmin() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        isAdmin() &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    // Master Kelas: kelas/{id}
    match /kelas/{kelasId} {
      allow get: if isVerifiedUser() && isValidId(kelasId) && (
        isAdmin() ||
        (isGuru() && resource.data.nama in myProfile().kelasDiampu) ||
        (isWaliKelas() && (resource.data.nama == myProfile().waliKelas || resource.data.waliKelas == request.auth.uid))
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (isGuru() && resource.data.nama in myProfile().kelasDiampu) ||
        (isWaliKelas() && (resource.data.nama == myProfile().waliKelas || resource.data.waliKelas == request.auth.uid))
      );
      allow create: if isAdmin() &&
        isValidId(kelasId) &&
        isValidKelas(incoming()) &&
        kelasId == incoming().nama &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(kelasId) &&
        isValidKelas(incoming()) &&
        incoming().nama == existing().nama &&
        incoming().diff(existing()).affectedKeys().hasOnly(['waliKelas', 'tahunAjaran', 'updatedAt']) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(kelasId);
    }

    // Master Mapel: mapel/{id}
    match /mapel/{mapelId} {
      allow get: if isVerifiedUser() && isValidId(mapelId) && (
        isAdmin() ||
        (isGuru() && (resource.data.guruId == request.auth.uid || resource.data.nama in myProfile().mapelDiampu)) ||
        isWaliKelas()
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (isGuru() && (resource.data.guruId == request.auth.uid || resource.data.nama in myProfile().mapelDiampu)) ||
        isWaliKelas()
      );
      allow create: if isAdmin() &&
        isValidId(mapelId) &&
        isValidMapel(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(mapelId) &&
        isValidMapel(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['nama', 'guruId', 'updatedAt']) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(mapelId);
    }

    // Data Siswa: siswa/{nis}
    match /siswa/{nis} {
      allow get: if isVerifiedUser() && isValidId(nis) && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow create: if isAdmin() &&
        isValidId(nis) &&
        nis.size() <= 30 &&
        isValidSiswa(incoming()) &&
        kelasExists(incoming().kelas) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(nis) &&
        isValidSiswa(incoming()) &&
        kelasExists(incoming().kelas) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['nama', 'kelas', 'jk', 'updatedAt']) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(nis);
    }

    // Absensi Harian: absensi/{kelasId_tanggal}
    match /absensi/{absensiId} {
      allow get: if isVerifiedUser() && isValidId(absensiId) && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow create: if isVerifiedUser() &&
        isValidId(absensiId) &&
        isValidAbsensi(incoming()) &&
        absensiId == (incoming().kelas + '_' + incoming().tanggal) &&
        kelasExists(incoming().kelas) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isGuru() && incoming().kelas in myProfile().kelasDiampu)
        );
      allow update: if isVerifiedUser() &&
        isValidId(absensiId) &&
        isValidAbsensi(incoming()) &&
        (
          isAdmin() ||
          (
            isGuru() &&
            existing().kelas in myProfile().kelasDiampu &&
            incoming().kelas == existing().kelas &&
            incoming().tanggal == existing().tanggal &&
            incoming().diff(existing()).affectedKeys().hasOnly(['records', 'updatedAt'])
          )
        ) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(absensiId) && (
        isAdmin() ||
        (isGuru() && existing().kelas in myProfile().kelasDiampu)
      );
    }

    // Nilai Siswa: nilai/{nis_mapel_semester}
    match /nilai/{nilaiId} {
      allow get: if isVerifiedUser() && isValidId(nilaiId) && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu && resource.data.mapel in myProfile().mapelDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu && resource.data.mapel in myProfile().mapelDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow create: if isVerifiedUser() &&
        isValidId(nilaiId) &&
        isValidNilai(incoming()) &&
        siswaInKelas(incoming().nis, incoming().kelas) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isGuru() && incoming().kelas in myProfile().kelasDiampu && incoming().mapel in myProfile().mapelDiampu)
        );
      allow update: if isVerifiedUser() &&
        isValidId(nilaiId) &&
        isValidNilai(incoming()) &&
        (
          isAdmin() ||
          (
            isGuru() &&
            existing().kelas in myProfile().kelasDiampu &&
            existing().mapel in myProfile().mapelDiampu &&
            incoming().kelas == existing().kelas &&
            incoming().mapel == existing().mapel &&
            incoming().nis == existing().nis &&
            incoming().semester == existing().semester &&
            incoming().diff(existing()).affectedKeys().hasOnly(['tugas', 'uts', 'uas', 'akhir', 'updatedAt'])
          )
        ) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(nilaiId) && (
        isAdmin() ||
        (isGuru() && existing().kelas in myProfile().kelasDiampu && existing().mapel in myProfile().mapelDiampu)
      );
    }

    // Rekap Absen Bulanan: rekapAbsen/{kelasId_bulan}
    match /rekapAbsen/{rekapId} {
      allow get: if isVerifiedUser() && isValidId(rekapId) && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow list: if isVerifiedUser() && (
        isAdmin() ||
        (isGuru() && resource.data.kelas in myProfile().kelasDiampu) ||
        (isWaliKelas() && resource.data.kelas == myProfile().waliKelas)
      );
      allow create: if isVerifiedUser() &&
        isValidId(rekapId) &&
        isValidRekapAbsen(incoming()) &&
        rekapId == (incoming().kelas + '_' + incoming().bulan) &&
        kelasExists(incoming().kelas) &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isGuru() && incoming().kelas in myProfile().kelasDiampu)
        );
      allow update: if isVerifiedUser() &&
        isValidId(rekapId) &&
        isValidRekapAbsen(incoming()) &&
        incoming().kelas == existing().kelas &&
        incoming().bulan == existing().bulan &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isGuru() &&
            existing().kelas in myProfile().kelasDiampu &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ringkasan', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(rekapId);
    }

    // Pengaturan Sekolah (Bobot Nilai Akhir & KKM): pengaturan/{pengaturanId}
    match /pengaturan/{pengaturanId} {
      allow get: if isVerifiedUser() && isValidId(pengaturanId) && (isAdmin() || hasActiveProfile());
      allow list: if false;
      allow create, update: if isAdmin() &&
        incoming().updatedAt == request.time && (
          (pengaturanId == 'bobotNilai' && isValidBobotNilai(incoming())) ||
          (pengaturanId == 'kkm' && isValidKkm(incoming()))
        );
      allow delete: if false;
    }
  }
}
